# v0 sandbox internal files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/

# Environment variables
.env
.env.*
!.env.example

# Secrets kept outside .env by hand. A key pasted into a note is still a key,
# and this one was one `git add -A` away from being committed.
*.rtf
*key*.txt
*secret*
credentials*

# Common ignores
node_modules
.next/
# .tools/ once held a downloaded Windows Node build and was ignored wholesale.
# It now holds the project's verification scripts — the only checks that run
# against the live grader and database — so the scripts are tracked. Anything
# else stays out: magic-link.mjs writes a one-time sign-in page to whatever
# path it is given, and that page must never reach a commit.
.tools/*
!.tools/*.mjs
# The figure renderer the PDF importers call: CoreGraphics, so Swift.
!.tools/*.swift
*.tsbuildinfo
.DS_Store

# Downloaded olympiad archives. Sixteen hundred files of someone else's
# content, kept on disk as the input to .tools/import-bcpf*.mjs. The importers
# are tracked; what they read is not, and neither is what they extract.
Олимпиады_по_*/
