.snowflake/
.vercel/

# Environment variables
.env
.env.*
!.env.example

# Secrets kept outside .env by hand. A key pasted into a note is still a key,
# and this one was one `git add -A` away from being committed.
*.rtf
*key*.txt
*secret*
credentials*

# Common ignores
node_modules
.next/
# .tools/ once held a downloaded Windows Node build and was ignored wholesale.
# It now holds the project's verification scripts — the only checks that run
# against the live grader and database — so the scripts are tracked. Anything
# else stays out: magic-link.mjs writes a one-time sign-in page to whatever
# path it is given, and that page must never reach a commit.
.tools/*
!.tools/*.mjs
*.tsbuildinfo
.DS_Store

# Local database (lib/db). Holds accounts and progress; never commit it.
.data/
scripts/__pycache__/
