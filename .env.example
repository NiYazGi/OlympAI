# --- Model provider -------------------------------------------------------
# Server-only. Used by /api/sulu (coaching) and by the attempt grader. Without
# it the app runs, but Sulu and grading report that they are unavailable.
OPENAI_API_KEY=your-server-only-openai-api-key
SULU_MODEL=gpt-5.4-mini

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database -------------------------------------------------------------
# Optional. Where the embedded Postgres keeps its files; defaults to .data/db.
# OLYMPAI_DB_DIR=.data/db
