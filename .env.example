# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Server-only. Grading writes task_attempts with the service role, because RLS
# grants `authenticated` no insert on that table: a row the browser can write is
# a row the browser can score. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-service-role-key

# --- Model provider -------------------------------------------------------
# Server-only. Used by /api/sulu (coaching) and by the attempt grader.
OPENAI_API_KEY=your-server-only-openai-api-key
SULU_MODEL=gpt-5.4-mini

# --- Migrations -----------------------------------------------------------
# Used only by scripts/migrate.mjs, never by the app. Full database access,
# bypasses RLS entirely. Project Settings -> Database -> Connection string,
# session mode (port 5432, not the 6543 transaction pooler: DDL needs it).
# Percent-encode special characters in the password.
SUPABASE_DB_URL=postgresql://postgres.your-ref:password@aws-0-region.pooler.supabase.com:5432/postgres
